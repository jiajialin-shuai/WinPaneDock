<Window x:Class="Cmux.Spike.Terminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="cmux M0 spike — Windows Terminal control"
        Width="1280"
        Height="760"
        MinWidth="800"
        MinHeight="500"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource UiText}"
        Background="{DynamicResource UiBackground}"
        Activated="OnWindowActivated"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="UiText" Color="#FFE6E8EC" />
        <SolidColorBrush x:Key="UiMuted" Color="#FFADB0B6" />
        <SolidColorBrush x:Key="UiBackground" Color="#FF17191D" />
        <SolidColorBrush x:Key="UiPanel" Color="#FF20242B" />
        <SolidColorBrush x:Key="UiSurface" Color="#FF30343B" />
        <SolidColorBrush x:Key="UiInput" Color="#FF242830" />
        <SolidColorBrush x:Key="UiBorder" Color="#FF454A53" />
        <SolidColorBrush x:Key="UiHover" Color="#FF41464F" />
        <SolidColorBrush x:Key="UiPressed" Color="#FF505A68" />
        <SolidColorBrush x:Key="UiSelected" Color="#FF334B68" />
        <SolidColorBrush x:Key="UiTerminal" Color="#FF0C0C0C" />
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource UiText}" />
            <Setter Property="Background" Value="{DynamicResource UiSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource UiHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource UiPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource UiText}" />
            <Setter Property="Background" Value="{DynamicResource UiInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="CaretBrush" Value="{DynamicResource UiText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{DynamicResource UiText}" />
            <Setter Property="Background" Value="{DynamicResource UiPanel}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource UiText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource UiHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource UiSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource UiText}" />
            <Setter Property="Background" Value="{DynamicResource UiInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      VerticalAlignment="Center" Margin="9,0,25,0" />
                                    <TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" />
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="{DynamicResource UiPanel}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="7"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="300"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource UiText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollTrackButton}" /></Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource UiBorder}" CornerRadius="5" Margin="2,1" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollTrackButton}" /></Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="SidebarPanel" Grid.Column="0" Grid.RowSpan="3"
                Background="{DynamicResource UiPanel}" Padding="12" BorderBrush="{DynamicResource UiBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,1,0,16">
                    <TextBlock Text="●" Foreground="#FFD71921" FontSize="10" VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock Text="CMUX / WORKSPACES" Foreground="{DynamicResource UiText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Row="1" Height="76" Margin="0,-5,0,10" ClipToBounds="True">
                    <Image Source="Assets/sidebar-ornament-dual.png" Stretch="Uniform" Opacity="0.6" />
                </Border>
                <StackPanel Grid.Row="2" Margin="0,0,0,5">
                    <TextBlock Text="NAME" Foreground="{DynamicResource UiMuted}" FontSize="11" Margin="0,0,0,5" />
                    <TextBox x:Name="WorkspaceNameInput" />
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="0,0,0,8">
                    <TextBlock Text="ROOT DIRECTORY" Foreground="{DynamicResource UiMuted}" FontSize="11" Margin="0,0,0,5" />
                    <TextBox x:Name="WorkspaceRootInput" />
                </StackPanel>
                <ListBox x:Name="WorkspaceList" Grid.Row="4" SelectionChanged="OnWorkspaceSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2,0,6">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Branch}" Foreground="{DynamicResource UiMuted}" FontSize="11" Margin="12,3,0,4" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers><DataTrigger Binding="{Binding Branch}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Terminals}" Margin="15,0,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Ellipse Width="7" Height="7" Fill="{Binding DotBrush}" ToolTip="{Binding StatusText}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding StatusText}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource UiMuted}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="+ Workspace" Click="OnNewWorkspaceClicked" />
                    <Button Content="Apply Root" Click="OnApplyRootClicked" />
                </StackPanel>
                <TextBlock x:Name="WorkspaceMessage" Grid.Row="6" Foreground="{DynamicResource UiMuted}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </Grid>
        </Border>

        <Grid x:Name="ProfileBar" Grid.Column="1" Background="{DynamicResource UiBackground}" Margin="10,7">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SidebarToggleButton" Content="☰" Width="36" ToolTip="Toggle sidebar" Click="OnToggleSidebarClicked" />
                <Button Content="⌕" Width="36" ToolTip="Commands (Ctrl+Shift+P)" Click="OnCommandsClicked" />
                <TextBlock Text="PROFILE" Foreground="{DynamicResource UiMuted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,8,0" />
                <ComboBox x:Name="ProfilePicker" Width="154" Margin="0,0,6,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource UiText}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="+ Group" Click="OnNewTabClicked" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ComboBox x:Name="ThemePicker" Width="94" SelectionChanged="OnThemeChanged" ToolTip="Appearance" Margin="0,0,6,0">
                    <ComboBoxItem Content="Night" /><ComboBoxItem Content="Day" /><ComboBoxItem Content="Gray" />
                </ComboBox>
                <Button x:Name="SettingsButton" Content="Settings" MinWidth="78" ToolTip="Settings and more" Click="OnSettingsClicked" Margin="0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ListBox x:Name="TerminalTabs" Grid.Row="0" Height="38"
                     SelectionChanged="OnTabSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&gt;_" Foreground="#FF8DBAF5" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" MouseLeftButtonDown="OnGroupTitleClicked" ToolTip="Double-click to rename group" />
                            <Button Content="×" Click="OnCloseTabItemClicked" Focusable="False" Height="24"
                                    ToolTip="Close group and its terminals" Background="Transparent" BorderThickness="0"
                                    Padding="5,0" Margin="10,0,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Background="{DynamicResource UiPanel}" Margin="0,0,0,1">
                <Button Content="Split Right" Click="OnSplitRightClicked" Margin="8,4,6,4" />
                <Button Content="Split Down" Click="OnSplitDownClicked" Margin="0,4,14,4" />
                <Button Content="Close Terminal" Click="OnClosePaneClicked" Margin="0,4,6,4" />
                <Button Content="Close Group" Click="OnCloseTabClicked" Margin="0,4,6,4" />
            </StackPanel>
            <Grid x:Name="TerminalHost" Grid.Row="2" Background="{DynamicResource UiTerminal}" />
        </Grid>

        <!-- 状态栏: 只用于 M0 观测, 不参与终端输入链路 -->
        <Border Grid.Row="2" Grid.Column="1"
                Background="{DynamicResource UiPanel}"
                Padding="8,4">
            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource UiMuted}"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Text="starting..." />
        </Border>
        <Popup x:Name="PalettePopup" Grid.Row="0" Grid.Column="1"
               PlacementTarget="{Binding ElementName=ProfileBar}" Placement="Bottom"
               HorizontalOffset="120" VerticalOffset="12" StaysOpen="False" AllowsTransparency="True">
            <Border Width="540" Height="400" Padding="12" Background="{DynamicResource UiPanel}"
                    BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="9">
                <DockPanel>
                    <TextBox x:Name="PaletteQuery" DockPanel.Dock="Top" FontSize="16"
                             TextChanged="OnPaletteQueryChanged" KeyDown="OnPaletteQueryKeyDown" />
                    <ListBox x:Name="PaletteList" Height="320" Margin="0,8,0,0" DisplayMemberPath="Label"
                             MouseDoubleClick="OnPaletteCommandDoubleClick" />
                </DockPanel>
            </Border>
        </Popup>
        <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True">
            <Border Width="220" Padding="9" Background="{DynamicResource UiPanel}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="TERMINAL" Foreground="{DynamicResource UiMuted}" FontSize="11" Margin="7,5,0,8" />
                    <Button x:Name="StartButton" Content="Start selected profile" Click="OnStartClicked" />
                    <Button x:Name="RestartButton" Content="Restart terminal" Click="OnRestartClicked" IsEnabled="False" />
                    <Button x:Name="CloseButton" Content="Close terminal" Click="OnCloseClicked" IsEnabled="False" />
                    <Button x:Name="KillButton" Content="Kill terminal" Click="OnKillClicked" IsEnabled="False" />
                    <Button x:Name="FocusButton" Content="Focus terminal" Click="OnFocusClicked" IsEnabled="False" />
                    <Button Content="Focus next pane" Click="OnFocusPaneClicked" />
                    <TextBlock Text="WORKSPACE" Foreground="{DynamicResource UiMuted}" FontSize="11" Margin="7,12,0,8" />
                    <Button Content="Rename workspace" Click="OnRenameWorkspaceClicked" />
                    <Button Content="Pin workspace" Click="OnPinWorkspaceClicked" />
                    <Button Content="Move up" Click="OnMoveWorkspaceUpClicked" />
                    <Button Content="Move down" Click="OnMoveWorkspaceDownClicked" />
                    <Button Content="Delete workspace" Click="OnDeleteWorkspaceClicked" />
                    <TextBlock Text="CONFIGURATION" Foreground="{DynamicResource UiMuted}" FontSize="11" Margin="7,12,0,8" />
                    <Button Content="Edit profiles.json" Click="OnEditProfilesClicked" />
                    <Button Content="Edit terminal settings" Click="OnEditSettingsClicked" />
                </StackPanel>
            </Border>
        </Popup>
        <Popup x:Name="NewWorkspacePopup" PlacementTarget="{Binding ElementName=WorkspaceList}" Placement="Center"
               StaysOpen="False" AllowsTransparency="True">
            <Border Width="320" Padding="16" Background="{DynamicResource UiPanel}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="9">
                <StackPanel>
                    <TextBlock Text="NEW WORKSPACE" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,14" />
                    <TextBlock Text="NAME" Foreground="{DynamicResource UiMuted}" FontSize="11" Margin="0,0,0,5" />
                    <TextBox x:Name="NewWorkspaceNameInput" Margin="0,0,0,12" />
                    <TextBlock Text="ROOT DIRECTORY" Foreground="{DynamicResource UiMuted}" FontSize="11" Margin="0,0,0,5" />
                    <TextBox x:Name="NewWorkspaceRootInput" Margin="0,0,0,8" />
                    <TextBlock x:Name="NewWorkspaceError" Foreground="LightCoral" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="OnCancelNewWorkspaceClicked" />
                        <Button Content="Create" Click="OnCreateWorkspaceClicked" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
        <Popup x:Name="GroupRenamePopup" PlacementTarget="{Binding ElementName=TerminalTabs}" Placement="Bottom"
               StaysOpen="True" AllowsTransparency="True">
            <Border Width="260" Padding="12" Background="{DynamicResource UiPanel}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="RENAME GROUP" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBox x:Name="GroupNameInput" KeyDown="OnGroupNameKeyDown" />
                    <TextBlock x:Name="GroupRenameError" Foreground="LightCoral" TextWrapping="Wrap" Margin="0,5,0,4" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Cancel" Click="OnCancelGroupRenameClicked" />
                        <Button Content="Save" Click="OnSaveGroupNameClicked" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
